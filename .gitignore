node_modules

# macOS
.DS_Store

/.cache
/build
/app/build
/public/build/
/public/_dev
/app/public/build
/prisma/dev.sqlite
/prisma/dev.sqlite-journal
database.sqlite

.env
.env.*
!.env.example

# package-lock.json is committed deliberately: CI needs `npm ci` for reproducible builds.
yarn.lock
pnpm-lock.yaml

/extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Hide files auto-generated by react router
.react-router/

chaos/artefacts/

# `app/types/admin-*.schema.json` is deliberately NOT ignored -- see #591. It is the
# pinned Admin schema, and committing it is what makes codegen produce the same answer
# on a laptop as in CI. While it was ignored, CI fetched it fresh on every run and a
# developer reused a cached copy, so Shopify editing a doc comment turned the next
# unrelated PR red with a diff nobody could reproduce locally.
perf-baseline-*.json

# Except the admin baseline, which is a record rather than a run artefact. The others are
# written to the repo root by a one-off measurement; this one is what `measure:admin`
# compares against on every run and what `readme-parity.test.ts` checks the published table
# against. A record that is not in version control is not a record, and a guard that reads
# a file CI does not have is a guard that can never fail.
!docs/perf/perf-baseline-admin.json
