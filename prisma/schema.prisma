// Anchor data model. Mirrors RFC-001 §3 -- see docs/rfc-001-architecture.md.
//
// Money is stored as BigInt minor units plus an explicit currency, matching
// app/lib/money. Never Float or Decimal: the whole arithmetic layer is built on the
// premise that a fractional minor unit cannot exist. BigInt rather than Int because
// Int tops out around $21M in cents, which a large B2B catalogue can exceed.

generator client {
  provider = "prisma-client-js"
}

// Postgres per RFC-001 §B1. The catalog mirror and the change ledger reach tens of
// millions of rows on large stores, and the resolver joins across them; SQLite (the
// template default) does not survive that.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- shopify auth

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?
}

// --------------------------------------------------------------------- shops

enum PlanTier {
  FREE
  GROWTH
  MARKETS
  WHOLESALE
}

model Shop {
  id     String @id @default(cuid())
  domain String @unique

  /// Offline access token, encrypted at rest (P0.3.5). Never stored in plaintext:
  /// a database dump must not yield a usable token.
  accessTokenEnc String?
  scopes         String?

  planTier   PlanTier @default(FREE)
  variantCap Int?

  /// The Shopify subscription behind the tier, and what state it is in. Without these a
  /// downgrade is indistinguishable from a webhook we missed.
  subscriptionGid    String?
  subscriptionStatus String?
  trialEndsAt        DateTime?
  planChangedAt      DateTime?

  /// Dev and partner stores are exempt from billing. Not a fifth tier: such a store is
  /// not on a plan at all, it is testing whichever tier it has selected.
  developerStore Boolean @default(false)

  /// IANA zone, e.g. "America/Toronto". Campaign times are stored UTC and rendered
  /// in this zone; the UI always shows which zone it is displaying.
  timezone String @default("UTC")

  /// Store-level guardrails, drift policy, blast-radius thresholds, notification
  /// preferences. JSON because these evolve faster than migrations should.
  settings Json @default("{}")

  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  /// Set when the initial catalog import finishes; campaigns are blocked until then.
  initialSyncCompletedAt DateTime?
  /// A catalogue sync in progress (#801): when it was claimed, which step it is on and how
  /// far that step has got, and when it last showed signs of life. All null when no sync
  /// is running. A sync is the first thing a new store does and the biggest: run inside a
  /// request it outlived the proxy, so it runs in the worker and Home follows it here.
  syncStartedAt   DateTime?
  syncPhase       String?
  syncProgress    Json?
  syncHeartbeatAt DateTime?
  /// Why the last sync stopped, in a sentence for the merchant. Cleared when one starts.
  syncFailure     String?

  variants         VariantIndex[]
  surfaceEntries   PriceSurfaceEntry[]
  baselines        Baseline[]
  segments         Segment[]
  campaigns        Campaign[]
  campaignRuns     CampaignRun[]
  variantChanges   VariantChange[]
  tagChanges       TagChange[]
  priceListChanges PriceListChange[]
  topologyNotices  TopologyNotice[]
  feedback         Feedback[]
  priceImports     PriceImport[]
  approvals        Approval[]
  writeIntents     WriteIntent[]
  driftEvents      DriftEvent[]
  roundingProfiles RoundingProfileRecord[]
  priceLists       PriceListRecord[]
  webhookEvents    WebhookEvent[]
  bulkOps          BulkOperationRecord[]
  auditEntries     AuditLogEntry[]
  errorEvents      ErrorEvent[]
  recaptures       BaselineRecapture[]
  planSummaries    PlanSummary[]

  @@index([uninstalledAt])
  @@map("shops")
}

// ------------------------------------------------------------- catalog mirror

enum VariantStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

/// Local mirror of the Shopify catalog. A cache -- Shopify is truth. The nightly
/// sampled audit (P1.6) is what keeps that honest.
model VariantIndex {
  shopId     String
  variantGid String
  productGid String

  sku     String?
  barcode String?
  title   String?

  /// The variant's own image, or its product's when the variant has none.
  ///
  /// Nullable and expected to be null: a product without a photo is normal, not an
  /// error, and every variant predating this column has none until the next sync.
  imageUrl String?

  /// Base-surface values in minor units, alongside the shop's primary currency.
  price     BigInt?
  compareAt BigInt?
  cost      BigInt?
  currency  String?

  inventoryQty Int?
  status       VariantStatus @default(ACTIVE)
  vendor       String?
  productType  String?
  tags         String[]      @default([])
  collections  String[]      @default([])

  /// Shopify's `Product.isGiftCard`, mirrored so campaigns can exclude gift cards.
  ///
  /// A gift card's price *is* its face value, so a percentage campaign sells store
  /// credit at a discount -- $100 of credit for $64 under a 20% sale, repeatably and
  /// without limit. `astToWhere` therefore drops these from every campaign scope.
  ///
  /// Defaults to false because that is what every row predating this column reads as,
  /// and false is the answer for all but a handful of variants on any shop. Rows
  /// written before the next catalogue sync are corrected by
  /// `scripts/backfill-gift-cards.ts`, which asks Shopify for `gift_card:true`
  /// directly rather than re-reading the whole catalogue.
  isGiftCard Boolean @default(false)

  /// Shopify's updated_at. Compared against incoming webhooks so out-of-order
  /// deliveries are ignored rather than applied (P1.3).
  remoteUpdatedAt DateTime?
  syncedAt        DateTime  @default(now())

  /// Tombstone rather than hard delete: ledger rows may still reference this
  /// variant and must stay resolvable on revert (edge case E4).
  deletedAt DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, variantGid])
  @@index([shopId, productGid])
  @@index([shopId, sku])
  @@index([shopId, price])
  @@index([shopId, status])
  @@index([shopId, deletedAt])
  /// GIN, for the `has` lookups campaigns scope by. Declared with an explicit type
  /// because a btree on an array column cannot serve containment.
  @@index([tags], type: Gin)
  @@index([collections], type: Gin)
  /// Trigram GIN, because `astToWhere` matches these two with `mode: "insensitive"`
  /// and Prisma compiles that to `ILIKE '%text%'`. No btree serves ILIKE -- including
  /// one on `lower(title)`, which is what these replace. See #510.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "variant_index_title_trgm")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "variant_index_sku_trgm")
  @@index([barcode(ops: raw("gin_trgm_ops"))], type: Gin, map: "variant_index_barcode_trgm")
  @@map("variant_index")
}

enum SurfaceKind {
  BASE
  MARKET
  B2B
}

/// Live values per price surface. Base rows live here too, deliberately: one uniform
/// shape means the resolver, planner and reconciliation read every surface the same
/// way instead of branching.
model PriceSurfaceEntry {
  id String @id @default(cuid())

  shopId       String
  variantGid   String
  surfaceKind  SurfaceKind
  /// Price list gid for MARKET/B2B. Empty string for BASE.
  ///
  /// Deliberately NOT nullable: Postgres treats NULLs as distinct in unique
  /// indexes, so a nullable column here would silently defeat every uniqueness
  /// guarantee below for base-surface rows -- including the one that stops a
  /// ledger row being written twice.
  priceListGid String      @default("")

  currency      String
  livePrice     BigInt?
  liveCompareAt BigInt?

  syncedAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, variantGid, surfaceKind, priceListGid])
  @@index([shopId, surfaceKind])
  @@index([shopId, priceListGid])
  @@map("price_surface_entries")
}

// -------------------------------------------------------------------- baselines

enum BaselineSource {
  INSTALL_CAPTURE
  RECAPTURE
  CSV_IMPORT
  DRIFT_ADOPTION
  AUTO_ENROLL
}

/// The durable reference price every campaign computes from -- the product's core
/// differentiator.
///
/// Append-only: a new capture supersedes rather than updates, so the history of what
/// a variant's reference price used to be survives. Current row is the one with
/// supersededAt = null, enforced by a partial unique index in the migration (Prisma
/// cannot express that declaratively).
model Baseline {
  id String @id @default(cuid())

  shopId       String
  variantGid   String
  /// BASE for the store price, MARKET for a price list's -- a wholesale catalogue's too,
  /// which the mirror files as B2B. Every campaign reads a list's baseline as MARKET, and
  /// one filed as B2B sat beside the campaign's own as a second baseline (#1071).
  surfaceKind  SurfaceKind
  priceListGid String      @default("")
  currency     String

  basePrice     BigInt
  baseCompareAt BigInt?
  /// Frequently absent on real catalogues. Never assume zero -- cost-dependent
  /// guardrails skip or error instead.
  cost          BigInt?

  /// The wholesale ladder this variant had before any campaign touched it, as
  /// `[{ minimumQuantity, amount }]` in integer minor units of `currency`.
  ///
  /// Only ever set on a wholesale catalogue's baselines, and null there means "no ladder",
  /// which is a real state rather than missing data -- most wholesale variants have a
  /// single price. So the sync records no baseline for a wholesale price whose ladder it
  /// could not read, and leaves it to the campaign's capture (#1071).
  /// It lives on the baseline rather than in its own table because revert recomputes
  /// from the baseline, so a ladder that is not part of the baseline could only be
  /// restored, and restoring is what this product deliberately does not do.
  quantityBreaks Json?

  /// A market baseline only: whether the merchant had set this price by hand on the list
  /// (a fixed price) rather than the list deriving it from the store price (#930). A
  /// revert writes a hand-set price back, recomputed without the campaign, and deletes a
  /// derived one so it follows the store price again. Null where it was never recorded --
  /// every baseline captured before this -- which a revert treats as derived.
  handSet Boolean?

  /// A derived market baseline only: the list's percentage, in basis points, when the price
  /// was read (#1093). A list whose percentage has moved since has a different regular
  /// price, and a campaign computing from this one would discount the old setting -- a
  /// 20%-off sale written above the market's new 30%-off price. Null for a fixed price, and
  /// for every derived baseline captured before this, which is read again when it can be.
  listAdjustmentBps Int?

  /// A wholesale baseline only: whether the catalogue's quantity ladder was read when this was
  /// captured (#1103). True with `quantityBreaks` null means "the merchant had none". Null
  /// means nobody looked -- every wholesale baseline a campaign captured while each ladder read
  /// failed -- which a tiered revert must not take for "none" and clear the merchant's ladder.
  ladderRead Boolean?

  source     BaselineSource
  capturedAt DateTime       @default(now())
  capturedBy String?

  supersededAt DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, variantGid, surfaceKind])
  @@index([shopId, supersededAt])
  @@map("baselines")
}

/// A recapture the recapture page started (#1105): what it covers, what the merchant
/// confirmed, which step it is on and how far that step has got, and how it ended.
///
/// A recapture whose wholesale prices need more quantity-ladder reads from Shopify than the
/// page can wait on is run by the worker, and the page follows it here, as Home follows a
/// sync on the shop row. A row of its own rather than more columns on the shop, for two
/// things a sync does not have: an outcome the page shows once it ends -- the sentence it
/// used to answer with -- and what the merchant confirmed, which the worker checks again
/// before it writes anything: the scope, the count they were shown, what they typed and
/// the campaigns they typed it over.
///
/// One unfinished row per shop, enforced by a partial unique index in the migration (Prisma
/// cannot express that declaratively): two recaptures of the same baselines at once collide
/// on the one-current-baseline index part-way through, and one of them stops half-written.
model BaselineRecapture {
  id     String @id @default(cuid())
  shopId String

  /// The scope, as `RecaptureScope` names it: a saved segment, the baselines changed outside
  /// a campaign, or the whole catalogue when neither is set.
  segmentId     String?
  stale         Boolean  @default(false)
  /// How many variants the page said this would rewrite, checked again when it runs (#716).
  scope         Int
  /// What the merchant typed to confirm, checked again against the phrase the scope demands.
  confirmation  String?
  /// The running campaigns it was confirmed over. One gone live on the scope since is
  /// refused, as Flow's capture refuses it (#773): the merchant was never shown it.
  confirmedOver String[] @default([])
  actor         String?

  /// `queued`, `checking`, `ladders` or `baselines`; `progress` is `{ done, total }` within it.
  phase       String
  progress    Json?
  startedAt   DateTime  @default(now())
  /// Stamped while it runs. A row quiet past `RECAPTURE_STALE_AFTER_MS` has stopped.
  heartbeatAt DateTime  @default(now())
  /// Set when it ends, however it ends; null while it is waiting or running.
  finishedAt  DateTime?
  /// What it did, once it finished: `CaptureResult` and the scope, counts only.
  outcome     Json?
  /// Why it stopped or was refused, in a sentence for the merchant.
  failure     String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, startedAt])
  @@map("baseline_recaptures")
}

// -------------------------------------------------------------------- segments

enum SegmentKind {
  /// Re-evaluated at run and enroll time, so new products join a running sale.
  DYNAMIC
  /// Variant list pinned at save time.
  FROZEN
}

model Segment {
  id String @id @default(cuid())

  shopId String
  name   String
  kind   SegmentKind @default(DYNAMIC)

  /// (OR of (AND of conditions)). JSON so segments stay versionable and previewable.
  filterAst         Json     @default("{}")
  /// Populated for FROZEN segments only.
  frozenVariantGids String[] @default([])

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaigns Campaign[] @relation("CampaignSegments")

  @@unique([shopId, name])
  @@index([shopId, kind])
  @@map("segments")
}

// ------------------------------------------------------------------- campaigns

enum CampaignStatus {
  DRAFT
  SCHEDULED
  APPLYING
  ACTIVE
  HELD
  REVERTING
  COMPLETED
  PARTIAL
  CANCELLED
}

model Campaign {
  id String @id @default(cuid())

  shopId String
  name   String
  status CampaignStatus @default(DRAFT)

  /// Higher wins. Tie-break is startAt, then id -- a total order, so preview and
  /// execution can never disagree about which campaign controls a variant.
  priority Int @default(100)

  /// Adjustment rules; where several match a variant, the last one wins (E16).
  ruleRows Json @default("[]")

  /// Surfaces targeted: base, and which market/B2B price lists.
  surfaces Json @default("{}")

  /// kind + optional rule.
  compareAtPolicy          Json   @default("{\"kind\":\"leave\"}")
  compareAtViolationPolicy String @default("clear")

  roundingProfileId        String?
  /// Campaign-level overrides. May only tighten the store's guardrails.
  guardrails               Json?
  guardrailViolationPolicy String  @default("clamp")

  /// What it prices, apart from when (#884): its filter -- the conditions and the product
  /// statuses it covers (#751) -- the saved segment it targets instead, its rounding, and
  /// whether it is practice. They lived in `schedule` beside the dates, so everything that
  /// copied or cleared "the schedule" had to know which half was which, and Duplicate did not
  /// (#762). `model.server.ts` reads and writes them, and nothing else.
  ///
  /// The whole record of what it prices since the contract (#1141): nothing is written into
  /// `schedule` or read from it, and its migration filled these from any blob that still held
  /// them before it stripped the copy. A column at its default is the campaign's answer.
  /// `filter` and `rounding` stay nullable as the expand half (#884) left them, so the
  /// release before needs no other schema; a null filter is read as no conditions.
  ///
  /// `segmentId` is not a foreign key: a campaign keeps the id of a segment deleted since,
  /// which is how it knows it prices nothing (#776). `segments` is what the delete guard
  /// reads. `rounding` is JSON rather than a string: a policy per currency, or the bare
  /// profile name a campaign from before per-currency rounding stored.
  filter    Json?
  segmentId String?
  rounding  Json?
  practice  Boolean @default(false)

  /// When it runs: kind (manual | window), start, end, revert buffer, the zone its times
  /// were typed in, and what became of its start and end. Beside them the campaign's own
  /// record (`OWN_KEYS` in `lib/campaigns/own-record.ts`), and nothing of what it prices (#1141).
  schedule Json      @default("{}")
  startAt  DateTime?
  endAt    DateTime?

  /// Tags applied on start and removed on end; the storefront hook that lets us
  /// ship no theme code at all.
  tagKit     String[] @default([])
  autoEnroll Boolean  @default(true)

  /// Set when a product enters this campaign's scope while it is running, and
  /// cleared once the scheduler has re-applied. A timestamp rather than a boolean
  /// so a queue that stops draining is visibly stuck rather than merely "true".
  enrollPendingAt DateTime?
  /// The variants waiting behind `enrollPendingAt`, so the scheduler prices those and
  /// nothing else. A whole-campaign re-apply for them re-discounted everything a
  /// part-finished revert had just restored (#805). Cleared with the mark.
  enrollPendingVariantGids String[] @default([])

  excludedVariantGids String[] @default([])

  /// Why this campaign exists, in the merchant's own words. Every audit asks it and
  /// nothing else in the record answers it: the ledger says what we wrote and the
  /// activity log says who asked, but neither says why.
  note String?

  /// Out of the list, still in the record. Orthogonal to `status` on purpose -- archiving
  /// is a filing decision and the lifecycle is a fact about live prices, so a state for it
  /// would make every transition table answer a question it has no business answering.
  /// The campaign is still reachable, and its runs and ledger are untouched.
  archivedAt DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop            Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  segments        Segment[]              @relation("CampaignSegments")
  roundingProfile RoundingProfileRecord? @relation(fields: [roundingProfileId], references: [id])
  runs            CampaignRun[]
  driftEvents     DriftEvent[]
  approvals       Approval[]
  planSummary     PlanSummary?

  @@index([shopId, status])
  @@index([shopId, startAt])
  @@index([shopId, endAt])
  /// The index lists unarchived campaigns on every load, so the default view is the one
  /// that gets the index.
  @@index([shopId, archivedAt])
  @@map("campaigns")
}

enum RunKind {
  APPLY
  REVERT
  REASSERT
  ENROLL
}

enum RunStatus {
  PLANNING
  QUEUED
  EXECUTING
  VERIFYING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum WritePath {
  SYNC
  BULK
}

model CampaignRun {
  id String @id @default(cuid())

  shopId     String
  campaignId String
  kind       RunKind
  status     RunStatus @default(PLANNING)

  /// Makes recurring runs idempotent: one run per (campaign, occurrence, kind),
  /// so a duplicate scheduler tick cannot double-apply.
  occurrenceKey String

  writePath WritePath?

  plannedRows  Int @default(0)
  verifiedRows Int @default(0)
  failedRows   Int @default(0)
  skippedRows  Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  /// Liveness, not progress. A process that is SIGKILLed cannot report its own
  /// death, so a run stuck in EXECUTING is indistinguishable from a slow one unless
  /// something is stamping this as it works. The scheduler reclaims runs whose
  /// heartbeat has gone quiet (P2.8).
  ///
  /// Deliberately not a fixed timeout on startedAt: a legitimate 200K-row bulk run
  /// takes hours, and a timeout long enough not to kill it would leave a genuinely
  /// dead run hanging for just as long.
  heartbeatAt DateTime?

  /// Progress, beside the liveness above: how many of the prices this run writes the executor
  /// has written (`writtenRows` of `writableRows`), stamped with `heartbeatAt` in the same
  /// update and under its throttle (#820). The run's own counts are written at its end, and
  /// the sync path settles its ledger rows in one batch once every product is written and read
  /// back, so this is the only count that moves while prices are written. The campaign page's
  /// time left reads it. Null before the first price, and on runs from before it.
  writtenRows  Int?
  writableRows Int?

  /// What a run handed to the worker was asked to do (#808, D29): who asked, the state its
  /// campaign was claimed from, whether it resumes, the variants to leave as they are. Written
  /// with the QUEUED row the web process creates before it enqueues, so the worker's tick can
  /// ring a run whose job Redis never took. Null for a run written where it was asked.
  request Json?

  shop             Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaign         Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  changes          VariantChange[]
  tagChanges       TagChange[]
  priceListChanges PriceListChange[]
  bulkOps          BulkOperationRecord[]

  @@unique([campaignId, occurrenceKey, kind])
  @@index([shopId, status])
  /// Drives the reaper's sweep: find non-terminal runs whose heartbeat is stale
  /// without scanning every run a shop has ever had.
  @@index([status, heartbeatAt])
  @@map("campaign_runs")
}

// ----------------------------------------------------------------- the ledger

enum ChangeStatus {
  PENDING
  WRITING
  APPLIED
  VERIFIED
  FAILED
  SKIPPED
  CLAMPED
  REVERTED
}

/// The change ledger. Rows are written BEFORE any Admin API call (invariant I4): if
/// the worker dies between writing the row and calling the API, verification finds an
/// unverified row and retries. The other order would change a merchant's storefront
/// with no record of it.
///
/// Partitioned by shopId in the migration; Prisma cannot express partitioning
/// declaratively, so it is applied as raw SQL.
model VariantChange {
  id String @id @default(cuid())

  runId  String
  shopId String

  variantGid   String
  surfaceKind  SurfaceKind
  priceListGid String      @default("")
  currency     String

  beforePrice     BigInt?
  beforeCompareAt BigInt?

  intendedPrice        BigInt?
  /// Null means "clear it"; the column being null with intendedCompareAtSet false
  /// means "leave it alone". Conflating the two either wipes a merchant's compare-at
  /// or fails to set up a strike-through.
  intendedCompareAt    BigInt?
  intendedCompareAtSet Boolean @default(false)

  appliedPrice  BigInt?
  verifiedPrice BigInt?

  /// The wholesale ladder this row intends to write, as
  /// `[{ minimumQuantity, amount }]` in integer minor units of `currency`.
  ///
  /// Only ever set on a B2B surface. Invariant I4 says nothing is written without a
  /// ledger row already committed, and for a tiered price the row is only a record of
  /// what will be written if it carries the rungs -- `intendedPrice` alone describes the
  /// first rung and silently loses the rest.
  quantityBreaks Json?

  status        ChangeStatus @default(PENDING)
  failureReason String?
  attempt       Int          @default(0)

  appliedAt  DateTime?
  verifiedAt DateTime?
  /// Shopify's own timestamp for this write: the product's `updatedAt` from the mutation's
  /// response, to the second, on Shopify's clock (#932). What the mirror is stamped with, so
  /// webhook ordering compares Shopify's clock with Shopify's clock. Null on rows written
  /// before it was recorded, and for any write whose response did not carry it.
  remoteUpdatedAt DateTime?
  createdAt  DateTime  @default(now())

  shop Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  run  CampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, variantGid, surfaceKind, priceListGid])
  @@index([shopId, status])
  @@index([runId, status])
  @@index([shopId, variantGid])
  @@map("variant_changes")
}

/// Fingerprint of every write we make, so the products/update webhook can tell our
/// own echo from a real merchant edit. Without it, drift detection would flag every
/// one of our own writes. TTL-pruned.
/// Tags a campaign applied to a product, and — the part that matters — which of them
/// it is entitled to take back.
///
/// A campaign asking for "SALE" on a product the merchant had already tagged "SALE"
/// adds nothing, so removing it on revert would delete the merchant's own
/// merchandising. `addedTags` records only what was genuinely absent beforehand;
/// `alreadyPresent` records what was deliberately left alone, so the ledger shows the
/// app knew about it rather than merely missing it.
model TagChange {
  id String @id @default(cuid())

  shopId     String
  runId      String
  campaignId String
  productGid String

  /// Ours: absent before this run, and the only tags a revert removes.
  addedTags      String[] @default([])
  /// The merchant's: asked for by the kit, already on the product, never touched.
  alreadyPresent String[] @default([])

  status        ChangeStatus @default(PENDING)
  failureReason String?

  appliedAt  DateTime?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  shop Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  run  CampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// One row per product per run: a resumed run must update its row rather than
  /// claim ownership of the same tags twice.
  @@unique([runId, productGid])
  @@index([shopId, campaignId])
  @@index([campaignId, status])
  @@map("tag_changes")
}

/// Ledger for a market-wide adjustment.
///
/// A parent adjustment is a property of the price list, not of any variant: one write
/// that moves every price on the market. It gets its own ledger because the thing a
/// revert must restore -- the merchant's own prior percentage -- exists nowhere else
/// once the campaign has overwritten it.
model PriceListChange {
  id String @id @default(cuid())

  shopId       String
  runId        String
  campaignId   String
  priceListGid String

  /// The merchant's percentage before this campaign, in basis points. Null means the
  /// list had no parent adjustment at all, which reverts differently from 0%: one
  /// removes the adjustment, the other pins it at zero.
  priorAdjustmentBps   Int?
  /// What the campaign set it to: the campaign's percentage composed with the prior one.
  appliedAdjustmentBps Int

  status        ChangeStatus @default(PENDING)
  failureReason String?

  appliedAt  DateTime?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  shop Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  run  CampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// One row per market per run, so a resumed run updates its row rather than
  /// recording the campaign's own adjustment as the prior one on the second pass --
  /// which would make the revert restore the sale.
  @@unique([runId, priceListGid])
  @@index([shopId, campaignId])
  @@index([campaignId, status])
  @@map("price_list_changes")
}

model WriteIntent {
  id String @id @default(cuid())

  shopId       String
  variantGid   String
  surfaceKind  SurfaceKind
  priceListGid String      @default("")

  valueHash String
  writtenAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, variantGid, valueHash])
  @@index([writtenAt])
  @@map("write_intents")
}

enum DriftResolution {
  PENDING
  ADOPTED
  REASSERTED
  IGNORED
}

/// A price changed outside the app while a campaign was active. The merchant made
/// that edit on purpose, so the app asks rather than guessing.
model DriftEvent {
  id String @id @default(cuid())

  shopId       String
  variantGid   String
  surfaceKind  SurfaceKind
  priceListGid String      @default("")
  campaignId   String?

  observedPrice BigInt?
  expectedPrice BigInt?
  currency      String

  resolution DriftResolution @default(PENDING)
  resolvedBy String?
  resolvedAt DateTime?
  detectedAt DateTime        @default(now())

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([shopId, resolution])
  @@index([shopId, variantGid])
  @@map("drift_events")
}

// ------------------------------------------------------------ rounding profiles

enum RoundingMode {
  CHARM
  STEP
}

/// A market or B2B price list, and how it derives its prices.
///
/// The mode is load-bearing rather than informational. A list with a `PriceListParent`
/// percentage adjustment *derives* every price from the base one; a list with fixed
/// overrides *stores* them. That decides whether a campaign can be written with one
/// mutation against the parent adjustment (P5.2) or has to write a row per variant —
/// the difference between one API call and five hundred thousand.
///
/// It is also why a relative list is never expanded into `price_surface_entries`. A
/// 500K-variant catalogue across four markets would be two million mirrored rows
/// restating a single percentage.
model PriceListRecord {
  id String @id @default(cuid())

  shopId       String
  priceListGid String
  name         String
  currency     String

  /// MARKET for a market catalog, B2B for a company-location one.
  surfaceKind SurfaceKind @default(MARKET)

  catalogGid   String?
  catalogTitle String?

  /// Basis points, so the adjustment never touches a float. A 5% decrease is -500.
  /// Null means the list stores fixed per-variant prices instead.
  /// One country this price list serves, for asking Shopify what a shopper there pays.
  ///
  /// `contextualPricing` is keyed by country, not by price list, and every country in a
  /// market sees the same price — so any one of its regions answers for all of them. Null
  /// for a list with no market behind it, such as a B2B catalogue, which is priced by
  /// company location instead.
  contextCountry String?

  adjustmentBps Int?

  syncedAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, priceListGid])
  @@index([shopId, surfaceKind])
  @@map("price_lists")
}

/// A market change a merchant has not answered yet.
///
/// A market deleted or re-denominated while campaigns target it is not an error and must
/// not fail a run (E15). It is a question -- extend the campaign, or leave it -- and the
/// question has to survive the sync that found it, because a merchant is rarely watching
/// when a background poll runs.
model TopologyNotice {
  id String @id @default(cuid())

  shopId String

  /// Matches TopologyChangeKind: removed, currency-changed, added.
  kind         String
  priceListGid String
  name         String
  /// The sentence shown to the merchant, rendered when the change was found so it still
  /// names the old currency after the mirror has moved on.
  detail       String

  /// Campaigns targeting this price list when the change was found.
  campaignIds String[] @default([])

  /// Set when answered. A resolved notice is kept rather than deleted, so "asked and
  /// dismissed" stays distinguishable from "never asked" and the next poll does not
  /// raise it again.
  resolvedAt DateTime?
  resolution String?
  createdAt  DateTime  @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@map("topology_notices")
}

/// Feedback a merchant sent from inside the app.
///
/// Persisted rather than emailed straight out: a merchant should be able to see that it
/// arrived, and telling them when it ships is what keeps a beta cohort engaged. Neither
/// is possible if the only copy is in somebody's inbox.
model Feedback {
  id String @id @default(cuid())

  shopId String

  message   String
  /// "problem", "idea" or "praise". Three, because a longer list makes people think.
  sentiment String

  /// Captured automatically. Asking "which screen were you on" wastes a question whose
  /// answer we already have, and every question asked is a reason not to send.
  route        String?
  planTier     String?
  variantCount Int?
  actor        String?

  /// Triage. Null means nobody has looked yet, which is what the weekly review reads.
  status     String?
  theme      String?
  shippedAt  DateTime?
  /// Set when the merchant was told it shipped.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([status])
  @@map("feedback")
}

/// A file of exact prices, applied as a campaign rather than written directly.
///
/// Setting prices from a spreadsheet is something a rule cannot express: one answer per
/// product. Writing them directly would break two rules at once -- the web process never
/// writes prices, and nothing changes without a ledger row a revert can recompute from.
/// So the import becomes a campaign whose rule says "look it up here", and preview,
/// guardrails, rounding, markets and revert all work unchanged.
model PriceImport {
  id String @id @default(cuid())

  shopId   String
  name     String
  currency String

  rowsRead    Int @default(0)
  rowsMatched Int @default(0)

  createdBy String?
  createdAt DateTime @default(now())

  shop Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rows PriceImportRow[]

  @@index([shopId, createdAt])
  @@map("price_imports")
}

/// One variant's price in an imported file.
///
/// Separate rows rather than JSON on the campaign: forty thousand prices in a JSON column
/// would be a second copy of the file that can disagree with the first.
model PriceImportRow {
  id String @id @default(cuid())

  importId   String
  variantGid String

  price     BigInt
  compareAt BigInt?

  priceImport PriceImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  /// A file naming a variant twice is a question, not two instructions.
  @@unique([importId, variantGid])
  @@map("price_import_rows")
}

/// A two-person rule for high-blast-radius campaigns.
///
/// The point is not the record -- the audit log already has that. It is that a campaign
/// above the threshold physically cannot run until somebody other than its author says
/// so.
model Approval {
  id String @id @default(cuid())

  shopId     String
  campaignId String

  /// Separate columns rather than a list, because the whole value of a two-person rule
  /// is that they are two different people, and a schema that could not express "the
  /// same person twice" as an error would let it happen.
  requestedBy String
  requestedAt DateTime @default(now())

  /// What the campaign would change when approval was asked for, so an approver is
  /// judging the campaign they were shown rather than one edited since.
  variantsAtRequest Int

  approvedBy String?
  approvedAt DateTime?
  declinedBy String?
  declinedAt DateTime?
  note       String?

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([shopId, requestedAt])
  @@map("approvals")
}

model RoundingProfileRecord {
  id String @id @default(cuid())

  shopId   String
  name     String
  currency String

  mode      RoundingMode
  /// Charm ending in minor units below one major unit (99 -> x.99).
  ending    Int?
  /// Step size in minor units.
  step      Int?
  direction String       @default("nearest")

  /// The shop default for this currency.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([shopId, name])
  @@index([shopId, currency])
  @@map("rounding_profiles")
}

// -------------------------------------------------------- webhooks & bulk ops

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

/// Dedup, replay and lag measurement. Shopify delivers at-least-once, so the unique
/// constraint on webhookId is what makes reprocessing safe.
model WebhookEvent {
  id String @id @default(cuid())

  /// X-Shopify-Webhook-Id.
  webhookId  String  @unique
  shopId     String?
  shopDomain String
  topic      String
  /// The delivery's body while it waits for the worker (#811), and `{}` once it has been
  /// handled: the log keeps metadata, not a second copy of the catalogue's prices.
  payload    Json

  /// What a queued delivery is about -- the product, for `products/*` -- so the worker
  /// handles one product's deliveries together and only the newest of them (#811).
  subjectGid String?

  status        WebhookStatus @default(RECEIVED)
  /// Deliveries: Shopify's retries of the same id.
  attempts      Int           @default(0)
  /// The worker's tries at handling a queued delivery that threw (#811), counted apart from
  /// Shopify's deliveries so a poison payload stops after a few rather than blocking its shop.
  processAttempts Int         @default(0)
  failureReason String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopDomain, topic])
  @@index([status, receivedAt])
  /// A shop's waiting deliveries, oldest first: what the worker drains (#811).
  @@index([shopId, status, receivedAt])
  /// One product's waiting deliveries, which the worker coalesces (#811).
  @@index([shopId, subjectGid, status])
  @@map("webhook_events")
}

enum BulkOpKind {
  QUERY
  MUTATION
}

enum BulkOpStatus {
  CREATED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
  EXPIRED
}

/// Tracks Shopify bulk operations, and doubles as the poll-fallback cursor for when
/// the bulk_operations/finish webhook never arrives (edge case E13).
model BulkOperationRecord {
  id String @id @default(cuid())

  shopId String
  runId  String?

  shopifyGid String       @unique
  kind       BulkOpKind
  status     BulkOpStatus @default(CREATED)

  stagedUploadPath String?
  resultUrl        String?
  objectCount      BigInt?
  errorCode        String?

  submittedAt  DateTime  @default(now())
  finishedAt   DateTime?
  lastPolledAt DateTime?

  shop Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  run  CampaignRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@map("bulk_operations")
}

// ------------------------------------------------------------------ audit log

/// Append-only record of every state-changing action. Exportable, because agencies
/// running pricing for clients need to prove exactly what changed and when.
/// Every unhandled failure, kept so a merchant quoting an id gets a real answer.
///
/// Deliberately a table rather than only a log line: logs roll over, and the one
/// question worth answering fast -- "is this happening to everyone or just them" --
/// needs a query, not a grep.
model ErrorEvent {
  id String @id @default(cuid())

  /// The short id shown on the error screen, e.g. ANC-K3M2-P7QR.
  errorId String @unique

  shopId      String?
  code        String
  /// The technical message. Never shown to a merchant.
  message     String
  stack       String?
  /// What the merchant was shown, so support can see both halves of the story.
  userMessage String

  route     String?
  method    String?
  /// Redacted structured detail: ids, counts, durations. Never tokens.
  context   Json?
  retryable Boolean @default(false)

  createdAt DateTime @default(now())

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([code, createdAt])
  @@map("error_events")
}

model AuditLogEntry {
  id String @id @default(cuid())

  shopId   String
  actor    String?
  action   String
  entity   String?
  entityId String?

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([shopId, action])
  @@map("audit_log")
}

/// The scheduler's own liveness, which nothing else in the system can stand in for.
///
/// The alerting window used to read the newest `campaign_runs.heartbeatAt` and call it
/// "seconds since tick". Those are stamped by campaign runs while they execute, so the
/// signal was wrong in both directions: on an idle shop — the normal state — the newest
/// one is hours old and the scheduler was reported stopped when it was fine, and a
/// scheduler that died while a long run was still stamping looked alive.
///
/// A dead process cannot report its own death, so this is detected by absence: the tick
/// stamps this row, and anything reading it decides. One row, in the database rather than
/// in memory, so a restarted process does not reset the picture and the same question can
/// be asked by hand during an incident.
model SchedulerHeartbeat {
  /// Always `singleton`. A primary key with one legal value keeps this to one row
  /// without a partial unique index over a table that has no other key.
  id String @id @default("singleton")

  beatAt DateTime @default(now()) @updatedAt

  /// Which process stamped it last. Only meaningful once more than one worker runs, and
  /// then it is the first thing an operator wants to know.
  instance String?

  @@map("scheduler_heartbeat")
}

// ------------------------------------------------------------- plan summaries

/// A campaign's plan, stored (#812): what its page, its Apply and Revert dialogs and its
/// rollback report read, instead of planning the whole campaign on every load.
///
/// Each answer is `previewCampaign`'s, `rollbackReport`'s and the Revert dialog's keepers as
/// those functions returned them -- the planner the run uses (rule 4), stored rather than
/// recomputed. The run plans again when it starts, and that plan alone decides prices.
///
/// `snapshot` is `pg_current_snapshot()` taken before the plan read anything. The summary is
/// current while no write logged in `plan_input_changes` for its shop is invisible to it;
/// see the migration, and `plan-summary.server.ts`.
model PlanSummary {
  campaignId String @id
  shopId     String

  /// The page's preview: counts, write path, the confirmation's reach, the table's rows,
  /// overlaps, margins, markets. Null until first planned.
  preview  Json?
  /// The rollback report, for a campaign that has written something and can be reverted.
  rollback Json?
  /// Who keeps which variants once this campaign is reverted, for the Revert dialog.
  keepers  Json?

  snapshot     String?
  /// The snapshot's xmin: no logged write older than this can be invisible to it, so the
  /// freshness check reads only the log from here on.
  snapshotXmin BigInt?
  /// When the snapshot was taken: the moment the stored numbers describe.
  computedAt   DateTime?
  /// When a background plan was last asked for, so a page asks once rather than every load.
  requestedAt  DateTime?

  /// How many of the campaign's variants have a baseline recaptured at its own sale price
  /// (#1166), as last counted: by its plan, or by the recapture, import or run that could have
  /// changed it. The campaigns list, Home and the calendar read it to say "needs a decision"
  /// without planning. Null until first counted. Not a plan input: writing it stales nothing.
  recapturedAtSale    Int?
  /// When that count began. A count begun earlier never replaces one begun later, so a plan
  /// that started before a recapture cannot put back the number from before it.
  recapturedCountedAt DateTime?

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("plan_summaries")
}

/// One write to a table a plan reads, by shop and transaction (#812). Written by the
/// database's own triggers, never by the app: see the migration that adds them.
///
/// No relation to the shop, deliberately: a shop's deletion cascades through the tables
/// these triggers sit on, and a row referencing the shop being deleted would fail it.
model PlanInputChange {
  id     BigInt   @id @default(autoincrement())
  shopId String
  /// The writing transaction's id, `pg_current_xact_id()`, as a bigint.
  xid    BigInt
  at     DateTime

  @@unique([shopId, xid])
  @@index([at])
  @@map("plan_input_changes")
}
