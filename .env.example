# Copy to `.env` and fill in. `.env` is gitignored -- never commit real credentials.
#
# SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SHOPIFY_APP_URL are managed by the Shopify CLI
# during `npm run dev`. You only set them by hand for a deployed environment.

# --- Shopify -----------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=write_products,read_markets

# --- Datastores (match docker-compose.yml) -----------------------------------
DATABASE_URL=postgresql://anchor:anchor@localhost:5432/anchor_dev
REDIS_URL=redis://localhost:6379

# --- Observability (RFC-001 B11) ---------------------------------------------
# Optional locally; required in staging/prod.
# Sentry. Absent means error reporting is local only — every failure still lands in
# error_events with an id a merchant can quote, and nothing leaves the process.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# The deployed commit. Without it a stack trace points at a line in a file that has moved,
# which is worse than no trace because it looks authoritative.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug

# --- Notifications (RFC-001 A-4.7) -------------------------------------------
# Optional locally; campaign completion/failure/drift emails no-op without it.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# --- Engine tuning (RFC-001 B8) ----------------------------------------------
# Fraction of the shop's observed GraphQL rate-limit budget we allow ourselves to
# consume, leaving headroom for the merchant's other apps (edge case E17).
RATE_LIMIT_HEADROOM=0.8
# Cap on concurrent bulk mutations per shop. Shopify allows 5 (API 2026-01); we
# stay under it so sync and audit jobs are never starved.
MAX_CONCURRENT_BULK_MUTATIONS=3
# Row count above which a run switches from the sync path to the bulk path.
BULK_PATH_ROW_THRESHOLD=1000

# Encrypts Shopify access tokens at rest (P0.3.5). Without it tokens are stored in plain
# text and a database dump contains working credentials for every connected store.
# Any string; it is hashed to a 256-bit key. Changing it invalidates every stored
# session, which signs merchants out rather than losing anything.
TOKEN_ENCRYPTION_KEY=


# Where operator alerts go. A different audience from merchant notifications: a merchant
# hears about their campaign, an operator hears that the scheduler has stopped for
# everybody. Absent means alerts are logged and not emailed.
OPERATOR_ALERT_EMAIL=
