# Copy to `.env` and fill in. `.env` is gitignored -- never commit real credentials.
#
# SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SHOPIFY_APP_URL are managed by the Shopify CLI
# during `npm run dev`. You only set them by hand for a deployed environment.

# --- Shopify -----------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=write_products,read_markets,write_markets

# --- Datastores (match docker-compose.yml) -----------------------------------
DATABASE_URL=postgresql://anchor:anchor@localhost:5432/anchor_dev
REDIS_URL=redis://localhost:6379

# --- Observability (RFC-001 B11) ---------------------------------------------
# Optional locally; required in staging/prod.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug

# --- Notifications (RFC-001 A-4.7) -------------------------------------------
# Optional locally; campaign completion/failure/drift emails no-op without it.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# --- Engine tuning (RFC-001 B8) ----------------------------------------------
# Fraction of the shop's observed GraphQL rate-limit budget we allow ourselves to
# consume, leaving headroom for the merchant's other apps (edge case E17).
RATE_LIMIT_HEADROOM=0.8
# Cap on concurrent bulk mutations per shop. Shopify allows 5 (API 2026-01); we
# stay under it so sync and audit jobs are never starved.
MAX_CONCURRENT_BULK_MUTATIONS=3
# Row count above which a run switches from the sync path to the bulk path.
BULK_PATH_ROW_THRESHOLD=1000
